# Slack에서 #커피주문 채널에 연결된 Incoming Webhook URL을 넣으세요.
SLACK_WEBHOOK_URL=
# Slack 메뉴 공지 읽기: 채널 기록 읽기 권한이 있는 봇 토큰 / 공지 메시지 링크
SLACK_BOT_TOKEN=
SLACK_MENU_MESSAGE_URL=
# 실제 메뉴는 slack에서 읽습니다. file은 SLACK_MOCK=1 연습 전용입니다.
MENU_SOURCE=slack
# 1: Slack에 보내지 않는 연습 모드 / 0: 실제 주문
SLACK_MOCK=1
PORT=8000
# 비워 두면 실행할 때마다 안전한 임의 키를 생성합니다.
TOKEN_SECRET=
