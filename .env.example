# 실제 Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# 1이면 Slack으로 실제 전송하지 않고 콘솔/메모리에만 기록합니다.
SLACK_MOCK=1

# 선택: 기기 인증 토큰 서명 키. 미설정 시 서버 시작 때 임시 키를 생성합니다.
DEVICE_TOKEN_SECRET=change-this-to-a-long-random-secret

PORT=8000

# 선택: Slack 채널에서 메뉴 공지를 직접 읽을 때 사용
# Incoming Webhook은 쓰기 전용이므로 읽기에는 Bot Token이 별도로 필요합니다.
SLACK_BOT_TOKEN=xoxb-...
SLACK_MENU_CHANNEL_ID=C0123456789
MENU_CACHE_SECONDS=30
